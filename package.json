{
  "name": "portfolio-builder",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @portfolio/web",
    "build": "npm run validate:registries && npm run build -w @portfolio/web",
    "start": "npm run start -w @portfolio/web",
    "validate:registries": "npm run validate -w @portfolio/themes && npm run validate -w @portfolio/widgets",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "jobs:github-resync": "tsx services/jobs/src/cli.ts github-resync",
    "jobs:analytics-rollup": "tsx services/jobs/src/cli.ts analytics-rollup",
    "jobs:payment-reconcile": "tsx services/jobs/src/cli.ts payment-reconcile"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "typescript": "^5.6.2",
    "tsx": "^4.19.1"
  }
}
