# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_builder?schema=public"

# Session cookie signing key (generate a long random string)
SESSION_SECRET="replace-with-a-long-random-string"

# Razorpay (test-mode keys from your Razorpay dashboard)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional: raises GitHub API rate limit from 60/hr to 5000/hr
GITHUB_TOKEN=""

# Shared secret for HTTP-triggered scheduled job routes
JOBS_SECRET="replace-with-a-long-random-string"

# Dev/test only — set to "true" to unlock every premium theme without a purchase.
# Leave unset (or anything other than "true") in any real deploy so the paywall actually gates.
DEV_UNLOCK_ALL_THEMES=""

# Object storage driver: "local" (dev) or "r2" (production - required on Render free tier
# since local disk is ephemeral and wiped on every redeploy/restart)
STORAGE_DRIVER="local"

# Base URL used to build absolute links for locally-stored uploads (schema requires a full URL).
# Defaults to http://localhost:3000 if unset.
APP_BASE_URL="http://localhost:3000"

# Only required when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
